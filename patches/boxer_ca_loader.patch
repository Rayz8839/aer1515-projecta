+def _depth_path(data_dir, seq_name, tag):
+    """CA-1M iPad LiDAR depth by default. AER1515: if BOXER_DEPTH_DIR is set, read an
+    alternative depth map (uint16 PNG, millimetres) from $BOXER_DEPTH_DIR/<seq>/<tag>.png."""
+    alt = os.environ.get("BOXER_DEPTH_DIR")
+    if alt:
+        return os.path.join(alt, seq_name, tag + ".png")
+    return os.path.join(data_dir, tag + ".wide", "depth.png")
